{
  "name": "rh-workflow-desk",
  "version": "0.3.0",
  "private": true,
  "author": "LLsetnow",
  "description": "RH Workflow Desk 的 macOS 桌面版",
  "main": "electron/main.cjs",
  "scripts": {
    "electron": "electron .",
    "package:mac": "./build-macos.sh"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "cn.runninghub.rhworkflowdesk",
    "productName": "RH Workflow Desk",
    "asar": true,
    "files": [
      "electron/**/*",
      "static/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/macos/rh-workflow-desk-server",
        "to": "rh-workflow-desk-server"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "RH-Workflow-Desk-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "static/assets/rh-workflow-desk.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  }
}
